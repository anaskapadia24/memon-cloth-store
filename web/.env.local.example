# Express API (backend/) - same API the legacy frontend/ site and admin panel call
NEXT_PUBLIC_API_BASE=http://localhost:5000/api

# Shared secret the Express backend sends when calling POST /api/revalidate
# after a product/category is created, updated, or deleted.
REVALIDATE_SECRET=replace-with-a-long-random-string

NEXT_PUBLIC_WHATSAPP_NUMBER=918452803023

# Same Google OAuth Client ID configured in backend/.env (GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id

NEXT_PUBLIC_SITE_URL=https://www.memonclothstore.com
