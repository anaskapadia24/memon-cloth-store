MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/memon-store
JWT_SECRET=replace-with-a-long-random-string
PORT=5000
NODE_ENV=production

# CORS allowlist - set both in production so only these origins can call the API.
FRONTEND_URL=https://www.memonclothstore.com
ADMIN_URL=https://admin.memonclothstore.com

# Get these from https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Gmail SMTP for order confirmation emails (use a Gmail App Password, not your login password)
EMAIL_USER=your_store_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Get these from https://cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Get these from https://app.shiprocket.in (used for shipment creation/tracking)
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_LOCATION=your_pickup_location_nickname

# Get this from https://console.cloud.google.com -> APIs & Services -> Credentials (OAuth Client ID)
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Next.js storefront (web/) on-demand revalidation - same REVALIDATE_SECRET as web/.env.local
NEXTJS_REVALIDATE_URL=https://www.memonclothstore.com
REVALIDATE_SECRET=replace-with-a-long-random-string
